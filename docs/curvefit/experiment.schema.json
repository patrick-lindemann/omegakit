{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string",
          "pattern": "^(\\?\\?\\?$|~import\\s|.*\\$\\{)"
        }
      ]
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "pattern": "^(\\?\\?\\?$|~import\\s|.*\\$\\{)"
        }
      ]
    },
    "run_dir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string",
          "pattern": "^(\\?\\?\\?$|~import\\s|.*\\$\\{)"
        }
      ]
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/definitions/curvefit.Splits"
        },
        {
          "type": "string",
          "pattern": "^(\\?\\?\\?$|~import\\s|.*\\$\\{)"
        }
      ]
    },
    "model": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "string",
          "pattern": "^(\\?\\?\\?$|~import\\s|.*\\$\\{)"
        }
      ]
    },
    "optimizer": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "string",
          "pattern": "^(\\?\\?\\?$|~import\\s|.*\\$\\{)"
        }
      ]
    },
    "trainer": {
      "anyOf": [
        {
          "type": "object",
          "if": {
            "properties": {
              "$class": {
                "const": "curvefit.trainer.Trainer"
              }
            },
            "required": [
              "$class"
            ]
          },
          "then": {
            "$ref": "#/definitions/curvefit.trainer.TrainerConfig"
          }
        },
        {
          "type": "string",
          "pattern": "^(\\?\\?\\?$|~import\\s|.*\\$\\{)"
        }
      ]
    },
    "metrics": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "string",
                "pattern": "^(\\?\\?\\?$|~import\\s|.*\\$\\{)"
              }
            ]
          }
        },
        {
          "type": "string",
          "pattern": "^(\\?\\?\\?$|~import\\s|.*\\$\\{)"
        }
      ]
    },
    "tracker": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "string",
          "pattern": "^(\\?\\?\\?$|~import\\s|.*\\$\\{)"
        }
      ]
    }
  },
  "patternProperties": {
    "^\\$": {}
  },
  "additionalProperties": false,
  "definitions": {
    "curvefit.Splits": {
      "type": "object",
      "properties": {
        "train": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "string",
              "pattern": "^(\\?\\?\\?$|~import\\s|.*\\$\\{)"
            }
          ]
        },
        "validation": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "string",
              "pattern": "^(\\?\\?\\?$|~import\\s|.*\\$\\{)"
            }
          ]
        },
        "test": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "string",
              "pattern": "^(\\?\\?\\?$|~import\\s|.*\\$\\{)"
            }
          ]
        }
      },
      "patternProperties": {
        "^\\$": {}
      },
      "additionalProperties": false
    },
    "curvefit.trainer.TrainerConfig": {
      "type": "object",
      "properties": {
        "epochs": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string",
              "pattern": "^(\\?\\?\\?$|~import\\s|.*\\$\\{)"
            }
          ]
        },
        "schedule": {
          "anyOf": [
            {
              "enum": [
                "constant",
                "cosine"
              ]
            },
            {
              "type": "string",
              "pattern": "^(\\?\\?\\?$|~import\\s|.*\\$\\{)"
            }
          ]
        }
      },
      "patternProperties": {
        "^\\$": {}
      },
      "additionalProperties": false
    }
  }
}
